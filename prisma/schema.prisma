generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DRIVER
}

enum DeliveryStatus {
  PENDING
  ACTIVE
  DELIVERED
  SKIPPED
  ADDRESS_ERROR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DRIVER)
  routes       Route[]  @relation("AssignedRoutes")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                   String     @id @default(cuid())
  name                 String
  street               String
  houseNumber          String
  postalCode           String
  city                 String
  phone                String?
  defaultDeliveryNotes String?
  latitude             Float?
  longitude            Float?
  deliveries           Delivery[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([name, street, houseNumber])
}

model Route {
  id               String     @id @default(cuid())
  name             String
  routeDate        DateTime
  startAddress     String
  endAddress       String?
  estimatedKm      Float?
  estimatedMins    Int?
  startedAt        DateTime?
  completedAt      DateTime?
  assignedDriver   User?      @relation("AssignedRoutes", fields: [assignedDriverId], references: [id])
  assignedDriverId String?
  deliveries       Delivery[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([routeDate])
}

model Delivery {
  id            String         @id @default(cuid())
  route         Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId       String
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  customerName  String
  street        String
  houseNumber   String
  postalCode    String
  city          String
  phone         String?
  orderInfo     String?
  mealCount     Int            @default(1)
  deliveryNotes String?
  latitude      Float?
  longitude     Float?
  routeOrder    Int
  status        DeliveryStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([routeId, routeOrder])
  @@index([status])
}
